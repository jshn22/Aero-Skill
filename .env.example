# AeroSkills — Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in your values.
# Vite only exposes variables prefixed with VITE_ to the browser.
# ─────────────────────────────────────────────────────────────

# ── REQUIRED ─────────────────────────────────────────────────
# Your Google Apps Script Web App URL.
# Handles BOTH the Contact form (type=contact)
# AND the Feedback form (type=feedback).
# Get this URL after deploying Code.gs → see setup_guide.md.
VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/REPLACE_WITH_YOUR_DEPLOYMENT_ID/exec

# ── OPTIONAL (Legacy Google Forms mode) ──────────────────────
# Uncomment ONLY if you are NOT using Apps Script.
# Use the Google Form's "pre-fill" entry IDs instead.
# VITE_GOOGLE_FORM_ACTION_URL=https://docs.google.com/forms/d/e/YOUR_FORM_ID/formResponse
# VITE_GFORM_FULL_NAME_ENTRY=entry.XXXXXXXXXX
# VITE_GFORM_EMAIL_ENTRY=entry.XXXXXXXXXX
# VITE_GFORM_GOAL_ENTRY=entry.XXXXXXXXXX
# VITE_GFORM_MESSAGE_ENTRY=entry.XXXXXXXXXX
